generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CREATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum CreatorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  REMOVED
}

enum ContentVisibility {
  PUBLIC
  FOLLOWERS
  SUBSCRIBERS
  PRIVATE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum RemovalRequestStatus {
  OPEN
  REVIEWING
  ACTIONED
  REJECTED
}

enum RemovalRequestReason {
  POSSIBLE_MINOR
  NON_CONSENSUAL
  RIGHTS_VIOLATION
  IMPERSONATION
  OTHER_ILLEGAL
}

enum SubscriptionType {
  PLATFORM_PREMIUM
  CREATOR
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  CCBILL
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CHARGEBACK
}

enum EarningStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  status       AccountStatus @default(ACTIVE)
  suspendedAt  DateTime?
  suspendedBy  String?
  suspensionReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creatorProfile      CreatorProfile?
  verificationRequests VerificationRequest[]
  followingCreators   CreatorFollow[] @relation("CreatorFollowing")
  auditLogs            AdminAuditLog[] @relation("AdminActor")
  passwordResetTokens  PasswordResetToken[]
  reports              ContentReport[] @relation("ReportAuthor")
  subscriptions        Subscription[] @relation("SubscriberSubscriptions")
  payments             Payment[]
  accessCodeRedemptions AccessCodeRedemption[]
  favorites            ContentFavorite[]
  blockedCreators      CreatorBlock[]

  @@index([role])
  @@index([status])
}

model CreatorProfile {
  id          String        @id @default(cuid())
  userId      String        @unique
  username    String        @unique
  displayName String
  bio         String?
  avatarUrl   String?
  isPublic    Boolean       @default(false)
  status      CreatorStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  followers   CreatorFollow[]      @relation("CreatorFollowers")
  contents    Content[]
  verifications VerificationRequest[]
  subscriptions Subscription[]
  earnings      CreatorEarning[]
  blockedBy     CreatorBlock[]

  @@index([status])
  @@index([isPublic])
}

model CreatorFollow {
  id         String   @id @default(cuid())
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())

  follower User           @relation("CreatorFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  creator  CreatorProfile @relation("CreatorFollowers", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([followerId, creatorId])
  @@index([followerId])
  @@index([creatorId])
}

model CreatorBlock {
  id        String   @id @default(cuid())
  userId    String
  creatorId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
}

model VerificationRequest {
  id              String             @id @default(cuid())
  userId          String
  creatorProfileId String?
  status          VerificationStatus @default(PENDING)
  provider        String?
  providerRef     String?
  submittedAt    DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorProfile CreatorProfile? @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Content {
  id          String            @id @default(cuid())
  creatorId   String
  title       String
  description String?
  mediaUrl    String?
  mediaType   MediaType?
  mimeType    String?
  sizeBytes   BigInt?
  status      ContentStatus     @default(DRAFT)
  visibility  ContentVisibility @default(PUBLIC)
  rejectionReason String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  reports ContentReport[]
  attestation ContentAttestation?
  removalRequests RemovalRequest[]
  favorites ContentFavorite[]

  @@index([creatorId])
  @@index([status])
  @@index([visibility])
}

model ContentFavorite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, createdAt])
  @@index([contentId])
}

model RemovalRequest {
  id          String               @id @default(cuid())
  reference   String               @unique @default(cuid())
  contentId   String?
  contentRef  String
  requesterName String
  requesterEmail String
  relationship String
  reason      RemovalRequestReason
  details     String
  goodFaith   Boolean
  status      RemovalRequestStatus @default(OPEN)
  adminNotes  String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  content Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([contentId])
  @@index([requesterEmail])
}

model ContentAttestation {
  id                    String   @id @default(cuid())
  contentId             String   @unique
  creatorId             String
  uploaderAdult         Boolean
  allParticipantsAdults Boolean
  consentObtained       Boolean
  distributionRights    Boolean
  declarationVersion    String   @default("2026-09")
  declaredAt            DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([declaredAt])
}

model ContentReport {
  id         String       @id @default(cuid())
  reporterId String
  contentId  String
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter User    @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  content  Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, contentId])
  @@index([contentId])
  @@index([status])
  @@index([createdAt])
}

model Plan {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  type        SubscriptionType
  amountMinor Int
  currency    String           @default("USD")
  billingDays Int              @default(30)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  subscriptions Subscription[]

  @@index([type])
  @@index([active])
}

model Subscription {
  id                 String             @id @default(cuid())
  subscriberId       String
  creatorId          String?
  planId             String
  type               SubscriptionType
  status             SubscriptionStatus @default(PENDING)
  provider           PaymentProvider     @default(CCBILL)
  providerRef        String?              @unique
  checkoutReference  String               @unique @default(cuid())
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  subscriber User            @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator    CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  plan       Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments   Payment[]
  accessCodeRedemptions AccessCodeRedemption[]

  @@index([subscriberId, status])
  @@index([creatorId, status])
  @@index([type, status])
}

model AccessCode {
  id              String   @id @default(cuid())
  codeHash        String   @unique
  label           String
  durationDays    Int
  maxRedemptions  Int      @default(1)
  redemptionCount Int      @default(0)
  expiresAt       DateTime?
  active          Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  redemptions AccessCodeRedemption[]

  @@index([active, expiresAt])
  @@index([createdAt])
}

model AccessCodeRedemption {
  id             String   @id @default(cuid())
  codeId         String
  userId         String
  subscriptionId String
  redeemedAt     DateTime @default(now())

  code         AccessCode    @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([codeId, userId])
  @@index([userId])
  @@index([subscriptionId])
}

model SecurityEvent {
  id              String   @id @default(cuid())
  fingerprintHash String
  action          String
  subject         String?
  success         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([fingerprintHash, action, createdAt])
  @@index([createdAt])
}

model Payment {
  id            String          @id @default(cuid())
  userId        String
  subscriptionId String?
  provider      PaymentProvider
  providerRef   String?         @unique
  eventRef      String?         @unique
  status        PaymentStatus   @default(PENDING)
  amountMinor   Int
  currency      String          @default("USD")
  paidAt        DateTime?
  failureReason String?
  rawEvent      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  earning      CreatorEarning?

  @@index([userId, status])
  @@index([subscriptionId])
  @@index([createdAt])
}

model CreatorEarning {
  id               String        @id @default(cuid())
  creatorId        String
  paymentId        String        @unique
  grossAmountMinor Int
  platformFeeMinor Int
  netAmountMinor   Int
  currency         String        @default("USD")
  status           EarningStatus @default(PENDING)
  availableAt      DateTime?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  payment Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([creatorId, status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}
